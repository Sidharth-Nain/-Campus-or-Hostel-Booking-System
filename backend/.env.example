# Copy this file to .env when PostgreSQL is configured.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://campusflow:change-me@localhost:5432/campusflow
# Replace this placeholder with a long random value before deploying.
JWT_SECRET_KEY=replace-with-a-long-random-secret

# Optional email delivery for booking approval/rejection notifications.
# Leave SMTP_HOST empty locally to preview notifications in the API terminal.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@campusflow.local
SMTP_USE_TLS=true
